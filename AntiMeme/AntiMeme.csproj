<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ProjectGuid>{6468C814-9D22-4A86-8207-B0CB86B78486}</ProjectGuid>
        <OutputType>Library</OutputType>
        <TargetFramework>net48</TargetFramework>
        <RootNamespace>AntiMeme</RootNamespace>
        <AssemblyName>AntiMeme</AssemblyName>
        <FileAlignment>512</FileAlignment>
        <LangVersion>latest</LangVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <!--
            nullable は無効のまま。EXILED / LabApi / ゲーム本体がすべて null 非注釈なので、
            enable にしても効いてほしい場所には効かず、? と ! の装飾だけが増える。
            必要なファイルだけ #nullable enable で opt-in する。
        -->
        <!-- NuGet で解決できないアセンブリ(ゲーム本体・Unity・ProjectMER)の置き場。 -->
        <SlDependenciesDir>$(MSBuildThisFileDirectory)..\Dependencies\</SlDependenciesDir>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
        <PlatformTarget>x64</PlatformTarget>
        <Prefer32Bit>false</Prefer32Bit>
        <DebugSymbols>true</DebugSymbols>
        <DebugType>full</DebugType>
        <Optimize>false</Optimize>
        <OutputPath>bin\Debug\</OutputPath>
        <DefineConstants>DEBUG;TRACE</DefineConstants>
        <ErrorReport>prompt</ErrorReport>
        <WarningLevel>4</WarningLevel>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
        <PlatformTarget>x64</PlatformTarget>
        <Prefer32Bit>false</Prefer32Bit>
        <DebugType>pdbonly</DebugType>
        <Optimize>true</Optimize>
        <OutputPath>bin\Release\</OutputPath>
        <DefineConstants>TRACE</DefineConstants>
        <ErrorReport>prompt</ErrorReport>
        <WarningLevel>4</WarningLevel>
    </PropertyGroup>

    <!--
        NuGet で解決するもの。
        ExMod.Exiled が Exiled.* / LabApi / Assembly-CSharp(Publicized) /
        CommandSystem.Core / NorthwoodLib / YamlDotNet をまとめて供給する。
        System.* は音声・メディア層 (ffmpeg / yt-dlp / HTTP) が要求する net48 向けバックポート。
    -->
    <ItemGroup>
        <PackageReference Include="ExMod.Exiled" Version="9.14.2"/>
        <PackageReference Include="Lib.Harmony" Version="2.2.2"/>
        <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.1"/>
        <PackageReference Include="System.Buffers" Version="4.6.1"/>
        <PackageReference Include="System.IO.Pipelines" Version="10.0.1"/>
        <PackageReference Include="System.Memory" Version="4.6.3"/>
        <PackageReference Include="System.Numerics.Vectors" Version="4.6.1"/>
        <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2"/>
        <PackageReference Include="System.Text.Encodings.Web" Version="10.0.1"/>
        <PackageReference Include="System.Text.Json" Version="10.0.1"/>
        <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.6.3"/>
        <PackageReference Include="System.ValueTuple" Version="4.6.1"/>
    </ItemGroup>

    <!--
        SharpServer ファミリのアセンブリ。ProjectMER 以外は Dependencies\ に無いので
        $(SL_References) (machine 環境変数 / SL_References リポジトリのミラー) から参照する。
    -->
    <ItemGroup>
        <Reference Include="HintServiceMeow-Exiled">
            <HintPath>$(SL_References)\HintServiceMeow-Exiled.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="SNAPI">
            <HintPath>$(SL_References)\SNAPI-HSM.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="Snake">
            <HintPath>$(SL_References)\Snake.dll</HintPath>
            <Private>False</Private>
        </Reference>
    </ItemGroup>

    <!--
        NuGet に無いものだけ Dependencies\ から手動参照する。
        Private=False: サーバー側に実体があるので出力へコピーしない。
    -->
    <ItemGroup>
        <Reference Include="Assembly-CSharp-firstpass">
            <HintPath>$(SlDependenciesDir)Assembly-CSharp-firstpass.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="Mirror">
            <HintPath>$(SlDependenciesDir)Mirror_publicized.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="Mirror.Components">
            <HintPath>$(SlDependenciesDir)Mirror.Components_publicized.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="ProjectMER">
            <HintPath>$(SlDependenciesDir)ProjectMER.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="Pooling">
            <HintPath>$(SlDependenciesDir)Pooling.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <!-- Newtonsoft.Json はサーバーが積んでいる実物に合わせる(NuGet 版だとバージョンがずれる)。 -->
        <Reference Include="Newtonsoft.Json">
            <HintPath>$(SlDependenciesDir)Newtonsoft.Json.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="UnityEngine">
            <HintPath>$(SlDependenciesDir)UnityEngine.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="UnityEngine.CoreModule">
            <HintPath>$(SlDependenciesDir)UnityEngine.CoreModule.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="UnityEngine.PhysicsModule">
            <HintPath>$(SlDependenciesDir)UnityEngine.PhysicsModule.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="UnityEngine.AnimationModule">
            <HintPath>$(SlDependenciesDir)UnityEngine.AnimationModule.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="UnityEngine.AudioModule">
            <HintPath>$(SlDependenciesDir)UnityEngine.AudioModule.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="UnityEngine.AssetBundleModule">
            <HintPath>$(SlDependenciesDir)UnityEngine.AssetBundleModule.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="Unity.TextMeshPro">
            <HintPath>$(SlDependenciesDir)Unity.TextMeshPro.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <!-- サーバーが実際に動く Mono ランタイムの corlib に合わせる。 -->
        <Reference Include="mscorlib">
            <HintPath>$(SlDependenciesDir)mscorlib.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <!--
            UnityEngine.AudioModule 等の Unity アセンブリは netstandard 2.1 を参照するため、
            net48 標準の netstandard 2.0 ファサードのままだと CS1705 になる
            (AudioClip.SetData/GetData の Span オーバーロード解決時に発生)。
            サーバー実体と同じ Mono 版 netstandard 2.1 を明示参照して合わせる。
        -->
        <Reference Include="netstandard">
            <HintPath>$(SlDependenciesDir)netstandard.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="System"/>
        <Reference Include="System.Core"/>
        <Reference Include="System.Data"/>
        <Reference Include="System.IO.Compression"/>
        <Reference Include="System.Net"/>
        <Reference Include="System.Net.Http"/>
        <Reference Include="System.Numerics"/>
        <Reference Include="System.Xml"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Sliced\Sliced.csproj"/>
    </ItemGroup>

    <!--
        AntiMeme は EXILED プラグインとしてロードされる (Sliced は LabAPI 側)。
        HSM / SNAPI が EXILED プラグインであることと、既存の EXILED 配備フローに乗るため。
        本番 7777 とは分離した 7778 で並走検証する。
    -->
    <!--
        SkipDeploy=true で配備をやめる。並行ビルド (複数の作業コピーから同時に叩く場合) が
        同じ 7778 フォルダを取り合って IO 例外になるのを避けるため。
    -->
    <Target Name="CopyToExiledPlugins" AfterTargets="Build" Condition="'$(SkipDeploy)' != 'true'">
        <PropertyGroup>
            <ExiledPluginsDir>$(APPDATA)\EXILED\Plugins\7778</ExiledPluginsDir>
            <ExiledDependenciesDir>$(APPDATA)\EXILED\Plugins\dependencies</ExiledDependenciesDir>
        </PropertyGroup>
        <ItemGroup>
            <ExiledDependencyFiles Include="$(OutputPath)Microsoft.Bcl.AsyncInterfaces.dll" Condition="Exists('$(OutputPath)Microsoft.Bcl.AsyncInterfaces.dll')"/>
            <ExiledDependencyFiles Include="$(OutputPath)System.Buffers.dll" Condition="Exists('$(OutputPath)System.Buffers.dll')"/>
            <ExiledDependencyFiles Include="$(OutputPath)System.IO.Pipelines.dll" Condition="Exists('$(OutputPath)System.IO.Pipelines.dll')"/>
            <ExiledDependencyFiles Include="$(OutputPath)System.Memory.dll" Condition="Exists('$(OutputPath)System.Memory.dll')"/>
            <ExiledDependencyFiles Include="$(OutputPath)System.Numerics.Vectors.dll" Condition="Exists('$(OutputPath)System.Numerics.Vectors.dll')"/>
            <ExiledDependencyFiles Include="$(OutputPath)System.Runtime.CompilerServices.Unsafe.dll" Condition="Exists('$(OutputPath)System.Runtime.CompilerServices.Unsafe.dll')"/>
            <ExiledDependencyFiles Include="$(OutputPath)System.Text.Encodings.Web.dll" Condition="Exists('$(OutputPath)System.Text.Encodings.Web.dll')"/>
            <ExiledDependencyFiles Include="$(OutputPath)System.Text.Json.dll" Condition="Exists('$(OutputPath)System.Text.Json.dll')"/>
            <ExiledDependencyFiles Include="$(OutputPath)System.Threading.Tasks.Extensions.dll" Condition="Exists('$(OutputPath)System.Threading.Tasks.Extensions.dll')"/>
        </ItemGroup>
        <MakeDir Directories="$(ExiledPluginsDir);$(ExiledDependenciesDir)"/>
        <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(ExiledPluginsDir)" SkipUnchangedFiles="false"/>
        <Copy SourceFiles="@(ExiledDependencyFiles)" DestinationFolder="$(ExiledDependenciesDir)" SkipUnchangedFiles="false"/>
    </Target>

</Project>
