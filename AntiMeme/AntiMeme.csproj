        </Reference>
        <Reference Include="Newtonsoft.Json">
            <HintPath>$(SlDependenciesDir)Newtonsoft.Json.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="YamlDotNet">
            <HintPath>$(SlDependenciesDir)YamlDotNet.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="UnityEngine">
            <HintPath>$(SlDependenciesDir)UnityEngine.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="UnityEngine.CoreModule">
            <HintPath>$(SlDependenciesDir)UnityEngine.CoreModule.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="UnityEngine.PhysicsModule">
