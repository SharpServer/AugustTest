<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ProjectGuid>{6468C814-9D22-4A86-8207-B0CB86B78486}</ProjectGuid>
        <OutputType>Library</OutputType>
        <TargetFramework>net48</TargetFramework>
        <RootNamespace>AntiMeme</RootNamespace>
        <AssemblyName>AntiMeme</AssemblyName>
        <FileAlignment>512</FileAlignment>
        <LangVersion>latest</LangVersion>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <!-- NuGet で解決できないアセンブリ(ゲーム本体・Unity・ProjectMER)の置き場。 -->
        <SlDependenciesDir>$(MSBuildThisFileDirectory)..\Dependencies\</SlDependenciesDir>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
        <PlatformTarget>x64</PlatformTarget>
        <Prefer32Bit>false</Prefer32Bit>
        <DebugSymbols>true</DebugSymbols>
        <DebugType>full</DebugType>
        <Optimize>false</Optimize>
        <OutputPath>bin\Debug\</OutputPath>
        <DefineConstants>DEBUG;TRACE</DefineConstants>
        <ErrorReport>prompt</ErrorReport>
        <WarningLevel>4</WarningLevel>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
        <PlatformTarget>x64</PlatformTarget>
        <Prefer32Bit>false</Prefer32Bit>
        <DebugType>pdbonly</DebugType>
        <Optimize>true</Optimize>
        <OutputPath>bin\Release\</OutputPath>
        <DefineConstants>TRACE</DefineConstants>
        <ErrorReport>prompt</ErrorReport>
        <WarningLevel>4</WarningLevel>
    </PropertyGroup>

    <!--
        NuGet で解決するもの。
        ExMod.Exiled が Exiled.* / LabApi / Assembly-CSharp(Publicized) /
        CommandSystem.Core / NorthwoodLib / YamlDotNet をまとめて供給する。
    -->
    <ItemGroup>
        <PackageReference Include="ExMod.Exiled" Version="9.14.2"/>
        <PackageReference Include="Lib.Harmony" Version="2.2.2"/>
    </ItemGroup>

    <!--
        NuGet に無いものだけ Dependencies\ から手動参照する。
        Private=False: サーバー側に実体があるので出力へコピーしない。
    -->
    <ItemGroup>
        <Reference Include="Assembly-CSharp-firstpass">
            <HintPath>$(SlDependenciesDir)Assembly-CSharp-firstpass.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="Mirror">
            <HintPath>$(SlDependenciesDir)Mirror_publicized.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="Mirror.Components">
            <HintPath>$(SlDependenciesDir)Mirror.Components_publicized.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="ProjectMER">
            <HintPath>$(SlDependenciesDir)ProjectMER.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="Pooling">
            <HintPath>$(SlDependenciesDir)Pooling.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <!-- Newtonsoft.Json はサーバーが積んでいる実物に合わせる(NuGet 版だとバージョンがずれる)。 -->
        <Reference Include="Newtonsoft.Json">
            <HintPath>$(SlDependenciesDir)Newtonsoft.Json.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="UnityEngine">
            <HintPath>$(SlDependenciesDir)UnityEngine.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="UnityEngine.CoreModule">
            <HintPath>$(SlDependenciesDir)UnityEngine.CoreModule.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="UnityEngine.PhysicsModule">
            <HintPath>$(SlDependenciesDir)UnityEngine.PhysicsModule.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="UnityEngine.AnimationModule">
            <HintPath>$(SlDependenciesDir)UnityEngine.AnimationModule.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="UnityEngine.AudioModule">
            <HintPath>$(SlDependenciesDir)UnityEngine.AudioModule.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="UnityEngine.AssetBundleModule">
            <HintPath>$(SlDependenciesDir)UnityEngine.AssetBundleModule.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="Unity.TextMeshPro">
            <HintPath>$(SlDependenciesDir)Unity.TextMeshPro.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <!-- サーバーが実際に動く Mono ランタイムの corlib に合わせる。 -->
        <Reference Include="mscorlib">
            <HintPath>$(SlDependenciesDir)mscorlib.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <!--
            UnityEngine.AudioModule 等の Unity アセンブリは netstandard 2.1 を参照するため、
            net48 標準の netstandard 2.0 ファサードのままだと CS1705 になる。
            サーバー実体と同じ Mono 版 netstandard 2.1 を明示参照して合わせる。
        -->
        <Reference Include="netstandard">
            <HintPath>$(SlDependenciesDir)netstandard.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="System"/>
        <Reference Include="System.Core"/>
        <Reference Include="System.Data"/>
        <Reference Include="System.Xml"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Sliced\Sliced.csproj"/>
    </ItemGroup>

    <Target Name="CopyToLabApiPlugins" AfterTargets="Build">
        <PropertyGroup>
            <LabApiPluginsDir>$(APPDATA)\SCP Secret Laboratory\LabAPI\plugins\7778</LabApiPluginsDir>
        </PropertyGroup>
        <MakeDir Directories="$(LabApiPluginsDir)"/>
        <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(LabApiPluginsDir)"
              SkipUnchangedFiles="false"/>
    </Target>

</Project>
